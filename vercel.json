{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/(.*)/",
            "destination": "/$1.html"
        },
        {
            "source": "/(.*)",
            "destination": "/$1.html"
        }
    ],
    "redirects": [
        {
            "source": "/(.*)\\.html",
            "destination": "/$1/",
            "permanent": true
        }
    ]
}